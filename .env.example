# =============================================================================
# AI Gateway — Environment Variables
# =============================================================================
# Copy to .env and fill in your API keys:
#   cp .env.example .env
#
# Only fill the providers you actually use. Tests skip providers without keys.
# =============================================================================

# ── AI Providers ─────────────────────────────────────────────────────────────

# OpenAI (STT, TTS, LLM, Realtime, Image, Omni)
OPENAI_API_KEY=sk-...

# Groq (STT, TTS, LLM — fast LPU inference)
GROQ_API_KEY=gsk_...

# OpenRouter (LLM aggregator + Image — 200+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Fireworks AI (STT, LLM, Image — Flux diffusion)
FIREWORKS_API_KEY=fw_...

# ── GPU Cloud Providers ──────────────────────────────────────────────────────

# RunPod (GPU pod provisioning)
RUNPOD_API_KEY=

# TensorDock (GPU instance provisioning)
TENSORDOCK_API_TOKEN=
TENSORDOCK_AUTH_ID=

# Vast.ai (GPU instance provisioning — HTTP access not viable, SSH only)
VAST_API_KEY=

# Modal (serverless GPU — TTS, function deployment)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Or combined format:
# MODAL_API_KEY=token_id:token_secret
# Proxy Auth Token for endpoint protection (format: "key:secret")
# MODAL_PROXY_SECRET=

# Hyperstack (GPU VMs — driver 570.195.03 default, required for CRIUgpu snapshot path)
HYPERSTACK_API_KEY=

# Standby pool global cap (ADR-013). Default 4. Hard ceiling across ALL
# registered profiles. A misconfigured per-profile maxStandby cannot exceed
# this number. Set to 0 to effectively disable the pool without unregistering
# profiles.
# STANDBY_POOL_GLOBAL_MAX=4
# STANDBY_POOL_HEALTH_TIMEOUT_MS=1200000

# ── Snapshot storage (CRIUgpu checkpoints, Phase B1-B3) ─────────────────────
# R2 is appropriate for snapshots (500MB-2GB each, rare egress). Do NOT reuse
# for model weights — R2 is 8x slower than HF CloudFront for 4GB+ files.
# Leave unset to disable snapshot capture entirely (gateway runs cold path).
R2_SNAPSHOTS_BUCKET=
R2_SNAPSHOTS_ENDPOINT=
R2_SNAPSHOTS_ACCESS_KEY=
R2_SNAPSHOTS_SECRET_KEY=

# Hyperstack Object Storage (S3-compatible, CANADA-1 only). When set, takes
# precedence over R2_SNAPSHOTS_* — use this when deploying GPUs on Hyperstack
# so snapshot downloads stay in-DC (much faster restore).
HYPERSTACK_SNAPSHOTS_BUCKET=
HYPERSTACK_SNAPSHOTS_ENDPOINT=
HYPERSTACK_SNAPSHOTS_ACCESS_KEY=
HYPERSTACK_SNAPSHOTS_SECRET_KEY=
# Region defaults to CANADA-1 (the only Hyperstack Object Storage region today).
# HYPERSTACK_SNAPSHOTS_REGION=CANADA-1

# Pre-baked Hyperstack Custom OS Image (see `ai-gateway gpu hyperstack
# build-bench-image`). When set, the deploy path boots from this image
# instead of vanilla Ubuntu — zero tool-install overhead, ~60s boot vs 5-7
# min. `imageId` is preferred (immune to name collisions); name is fallback.
# HYPERSTACK_BENCH_IMAGE_ID=
# HYPERSTACK_BENCH_IMAGE_NAME=

# ── Infrastructure ───────────────────────────────────────────────────────────

# HuggingFace (model downloads, container injection)
HF_TOKEN=hf_...

# Vault (optional AES-256-GCM encrypted secret store)
# Use a 64-char hex master key and a local file path outside Git.
# VAULT_MASTER_KEY=
# VAULT_PATH=/absolute/path/to/.vault.json

# GPU Access Token signing (HMAC secret for GPU cluster auth)
GPU_ACCESS_SECRET=min-32-char-random-string-here

# ── Optional Overrides ───────────────────────────────────────────────────────

# Modal TTS endpoint override
# MOSS_TTS_URL=https://custom-endpoint.modal.run

# Docker image for GPU deployments
# PARLE_DOCKER_IMAGE=marcosremar/parle-s2s-light:latest

# TensorDock SSH public key (for VM access)
# TENSORDOCK_SSH_PUBKEY=ssh-ed25519 AAAA...
