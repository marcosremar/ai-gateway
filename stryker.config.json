/**
 * Stryker Mutation Testing Configuration for AI Gateway.
 *
 * Mutation testing verifies that your tests actually catch bugs by
 * introducing small changes (mutations) to your code and checking
 * if the test suite fails.
 *
 * Usage:
 *   npx stryker run
 *
 * This will:
 * 1. Generate mutations in your source code
 * 2. Run the test suite against each mutation
 * 3. Report which mutations were caught (killed) vs survived
 *
 * Mutation score target: >80%
 */

/** @type {import('@stryker-mutator/api').PartialStrykerOptions} */
const config = {
  // Package manager
  packageManager: 'npm',

  // Test runner
  testRunner: 'command',
  testRunner_comment: 'Vitest via command runner',
  commandRunner: {
    command: 'bun run test:unit',
  },

  // Mutators
  mutator: {
    plugins: [],
  },

  // Thresholds for CI failure
  thresholds: {
    high: 80,   // Green: >= 80% mutation score
    low: 60,    // Red: < 60% mutation score
    break: 50,  // CI fails if < 50%
  },

  // Files to mutate
  mutate: [
    'src/**/*.ts',
    '!src/**/*.test.ts',
    '!src/**/*.spec.ts',
    '!src/**/index.ts',     // Barrel files
    '!src/types/**/*',      // Type-only files
    '!src/constants/**/*',  // Constant-only files
    '!src/browser/**/*',    // Browser SDK has own tests
  ],

  // Files to include in analysis (but not mutate)
  files: [
    'src/**/*.ts',
    '__tests__/**/*.ts',
  ],

  // Exclude patterns
  ignorePatterns: [
    '.git',
    'node_modules',
    'dist',
    'coverage',
    '.next',
    '**/*.d.ts',
  ],

  // Reporting
  reporters: [
    'html',    // Detailed HTML report in reports/mutation/html/
    'clear-text', // Console output
    'json',    // JSON output in reports/mutation/mutation.json
  ],

  // HTML report location
  htmlReporter: {
    baseDir: 'reports/mutation',
  },

  // Concurrency (use all available cores)
  concurrency: 4,
  concurrency_comment: 'Set to number of CPU cores for best performance',

  // Timeout per mutation test (ms)
  timeoutMS: 30_000,

  // Dry run: run tests without mutations to establish baseline
  dryRunOnly: false,

  // Build command (if needed before testing)
  buildCommand: 'bun run build',

  // Ignore static mutants (often false positives)
  ignoreStatic: true,

  // Check for coverage correlation
  checker: {
    plugins: [],
  },

  // Temp directory for mutation runs
  tempDirName: '.stryker-tmp',
};

module.exports = config;
