{
  "name": "parle-speech",
  "app": "parle",
  "description": "parle: Whisper + Qwen LLM + Qwen3-TTS in one container (docker/speech-stack, public copy on ghcr) with the realtime edge; since 14/10/2026 also the cast's cloned voices (the parle-tts route names it). Vast only, hosts in an EU country only (owner, 14/10/2026: «usa máquinas do vast.ai», Scaleway no longer used; the students' audio never leaves the EU): an RTX 5090, else an L40S or an RTX 4090, each at most €0.85/h; three warm for the Mon-Thu class (16:40-20:30 Paris; class at 17:40)",
  "profile": "speech-stack",
  "image": {
    "default": "ghcr.io/marcosremar/speech-stack:20261011-0200"
  },
  "spec": {
    "provider": "vast",
    "machineType": "RTX 5090",
    "maxEurPerHour": 0.85,
    "placements": [],
    "candidates": [
      { "provider": "vast", "machineType": "RTX 5090", "maxEurPerHour": 0.85 },
      { "provider": "vast", "machineType": "L40S", "maxEurPerHour": 0.85 },
      { "provider": "vast", "machineType": "RTX 4090", "maxEurPerHour": 0.85 }
    ],
    "euOnly": true,
    "minCuda": 13,
    "maxRttExcessMs": 20,
    "idleAction": "delete",
    "maxReplicas": 3,
    "entrypoint": "bash",
    "args": ["/opt/s2s/start.sh"],
    "coldStartWaitSeconds": 240,
    "env": {},
    "scaling": { "mode": "fast", "budget": { "eurPerMonth": 450 } },
    "warmSchedule": [
      { "days": [1, 2, 3, 4], "start": "16:40", "end": "20:30", "timeZone": "Europe/Paris", "minReplicas": 3 }
    ],
    "reserveQuota": null,
    "envByMachineType": {
      "RTX 5090": {
        "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "9600", "RT_MAX_SESSIONS": "4",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "L40S": {
        "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "12000", "RT_MAX_SESSIONS": "4", "LLM_SLOT_CTX": "4096",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "RTX 4090": {
        "STT_BATCH": "4", "LLM_PARALLEL": "8", "LLM_SLOT_CTX": "2048", "TTS_STAGE0_MB": "7400", "RT_MAX_SESSIONS": "2",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      }
    },
    "realtime": {}
  }
}
