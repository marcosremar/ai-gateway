{
  "name": "parle-speech",
  "app": "parle",
  "description": "parle: Whisper + Qwen LLM + Qwen3-TTS (cast's cloned voices, the parle-tts route names it) in one container (speech-stack, public ghcr copy) with the realtime edge. Vast only, EU hosts only (owner, 14/10/2026: no Scaleway; students' audio stays in the EU): an RTX 3090 at most €0.30/h, the cheapest (owner, 14/10/2026), else an RTX 4090 or 5090 at most €0.85/h; three warm Mon-Thu 17:00-20:30 Paris (a new host boots in ~20 min)",
  "profile": "speech-stack",
  "image": {
    "default": "ghcr.io/marcosremar/speech-stack:20261011-0200"
  },
  "spec": {
    "provider": "vast",
    "machineType": "RTX 3090",
    "maxEurPerHour": 0.3,
    "placements": [],
    "candidates": [
      { "provider": "vast", "machineType": "RTX 3090", "maxEurPerHour": 0.3 },
      { "provider": "vast", "machineType": "RTX 4090", "maxEurPerHour": 0.85 },
      { "provider": "vast", "machineType": "RTX 5090", "maxEurPerHour": 0.85 }
    ],
    "euOnly": true,
    "minCuda": 13,
    "maxRttExcessMs": 20,
    "idleAction": "delete",
    "maxReplicas": 3,
    "entrypoint": "bash",
    "args": ["/opt/s2s/start.sh"],
    "coldStartWaitSeconds": 240,
    "env": {},
    "scaling": { "mode": "fast", "budget": { "eurPerMonth": 450 } },
    "warmSchedule": [
      { "days": [1, 2, 3, 4], "start": "17:00", "end": "20:30", "timeZone": "Europe/Paris", "minReplicas": 3 }
    ],
    "reserveQuota": null,
    "envByMachineType": {
      "RTX 3090": {
        "STT_BATCH": "4", "LLM_PARALLEL": "8", "LLM_SLOT_CTX": "2048", "TTS_STAGE0_MB": "7400", "RT_MAX_SESSIONS": "2",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "RTX 4090": {
        "STT_BATCH": "4", "LLM_PARALLEL": "8", "LLM_SLOT_CTX": "2048", "TTS_STAGE0_MB": "7400", "RT_MAX_SESSIONS": "2",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "RTX 5090": {
        "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "9600", "RT_MAX_SESSIONS": "4",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      }
    },
    "realtime": {}
  }
}
