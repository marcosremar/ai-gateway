{
  "name": "parle-speech",
  "app": "parle",
  "description": "parle: Whisper + Qwen LLM + Qwen3-TTS in one container (docker/speech-stack) with the realtime edge, on one Scaleway L40S (fr-par-2, then pl-waw-2), then an H100 80 GB (fr-par-2, then pl-waw-2), then one RTX 5090 on Vast from the public copy of the image; no L4 (its quota belongs to the TTS); warm and reserved for the Mon-Thu class (17:30-20:30 Paris)",
  "profile": "speech-stack",
  "image": {
    "env": "SPEECH_IMAGE",
    "repository": "rg.fr-par.scw.cloud/aigw/speech-stack",
    "default": "rg.fr-par.scw.cloud/aigw/speech-stack:20261009-0213"
  },
  "spec": {
    "placements": [
      { "zone": "pl-waw-2" },
      { "zone": "fr-par-2", "machineType": "H100-1-80G", "maxEurPerHour": 3 },
      { "zone": "pl-waw-2", "machineType": "H100-1-80G", "maxEurPerHour": 3 },
      { "provider": "vast", "machineType": "RTX 5090", "maxEurPerHour": 0.85, "maxReplicas": 1, "image": "ghcr.io/marcosremar/speech-stack:20261009-0213" }
    ],
    "entrypoint": "bash",
    "args": ["/opt/s2s/start.sh"],
    "coldStartWaitSeconds": 240,
    "scaling": { "mode": "fast", "budget": { "eurPerMonth": 300 } },
    "warmSchedule": [
      { "days": [1, 2, 3, 4], "start": "17:30", "end": "20:30", "timeZone": "Europe/Paris", "minReplicas": 1 }
    ],
    "reserveQuota": {
      "quota": 2,
      "windows": [{ "days": [1, 2, 3, 4], "start": "17:30", "end": "20:30", "timeZone": "Europe/Paris", "minReplicas": 2 }]
    },
    "envByMachineType": {
      "L4-1-24G": { "RT_MAX_SESSIONS": "2" },
      "L40S-1-48G": { "RT_MAX_SESSIONS": "4" },
      "H100-1-80G": { "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "12000", "RT_MAX_SESSIONS": "4", "LLM_SLOT_CTX": "2048" },
      "RTX 5090": {
        "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "9600", "RT_MAX_SESSIONS": "4",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      }
    },
    "realtime": {}
  }
}
