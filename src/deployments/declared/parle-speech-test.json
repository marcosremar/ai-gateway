    ],
    "euOnly": true,
    "minCuda": 13,
    "imageGb": 22.3,
    "bootRace": 1,
    "maxRttExcessMs": 50,
    "minReplicas": 0,
    "maxReplicas": 1,
    "idleMinutes": 10,
    "idleAction": "delete",
    "scaling": { "mode": "fast", "budget": { "eurPerMonth": 40 } },
