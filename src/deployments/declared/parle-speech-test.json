{
  "name": "parle-speech-test",
  "app": "parle",
  "description": "parle: test copy of parle-speech (same image, same Vast ladder on hosts in an EU country only, owner 14/10/2026: «usa máquinas do vast.ai», no Scaleway): an RTX 3090 at most €0.30/h (owner, 14/10/2026: «deve usar rtx 3090 porque é mais barata»), else an RTX 4090 or an RTX 5090 at most €0.85/h; started only on purpose (POST /v1/deployments/parle-speech/start by a capped client key), never by a request, no warm schedule, deleted after 10 min idle",
  "profile": "speech-stack",
  "image": {
    "default": "ghcr.io/marcosremar/speech-stack:20261011-0200"
  },
  "spec": {
    "testFor": "parle-speech",
    "provider": "vast",
    "machineType": "RTX 3090",
    "maxEurPerHour": 0.3,
    "placements": [],
    "candidates": [
      { "provider": "vast", "machineType": "RTX 3090", "maxEurPerHour": 0.3 },
      { "provider": "vast", "machineType": "RTX 4090", "maxEurPerHour": 0.85 },
      { "provider": "vast", "machineType": "RTX 5090", "maxEurPerHour": 0.85 }
    ],
    "euOnly": true,
    "minCuda": 13,
    "maxRttExcessMs": 20,
    "minReplicas": 0,
    "maxReplicas": 1,
    "idleMinutes": 10,
    "idleAction": "delete",
    "scaling": { "mode": "fast", "budget": { "eurPerMonth": 40 } },
    "envByMachineType": {
      "RTX 3090": {
        "STT_BATCH": "4", "LLM_PARALLEL": "8", "LLM_SLOT_CTX": "2048", "TTS_STAGE0_MB": "7400", "RT_MAX_SESSIONS": "2",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "RTX 4090": {
        "STT_BATCH": "4", "LLM_PARALLEL": "8", "LLM_SLOT_CTX": "2048", "TTS_STAGE0_MB": "7400", "RT_MAX_SESSIONS": "2",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      },
      "RTX 5090": {
        "STT_BATCH": "8", "LLM_PARALLEL": "16", "TTS_STAGE0_MB": "9600", "RT_MAX_SESSIONS": "4",
        "TTS_MODEL": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "LLM_FILE": "Qwen3.5-9B-Q4_K_M.gguf"
      }
    }
