#SNAPGPU_S3_SECRET_KEY=<B2 applicationKey>
#SNAPGPU_S3_REGION=us-west-004
#SNAPGPU_S3_KEY_PREFIX=snapshots/
#SNAPGPU_DEFAULT_BACKEND=vast
