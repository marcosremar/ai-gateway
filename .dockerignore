# Dependencies
node_modules
.pnp
.pnp.js
bun.lockb

# Build outputs
dist/
coverage/
.turbo/
*.tsbuildinfo

# Environment files (never include secrets in images)
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude AI worktrees (2500+ duplicate files)
.claude/worktrees/
.claude/

# Python virtual environments
.venv*
venv/
__pycache__/
*.pyc
.pytest_cache/

# Test outputs
test-results/
playwright-report/

# Documentation (not needed in runtime image)
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
LICENSE

# Docker files (not needed inside container)
docker-compose*.yml
Dockerfile*
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Terraform/Helm (not needed in runtime)
terraform/
helm/

# Monitoring (source only, not provisioning files)
monitoring/

# Scripts (some may be needed, but most are build-time)
scripts/
!scripts/reap-orphans.ts
# `bun install` in Dockerfile runs package.json's postinstall (`bash scripts/postinstall.sh`): without it the build exits 127.
!scripts/postinstall.sh
tools/

# Dockers subproject (separate images)
dockers/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Test fixtures
fixtures.ts
__tests__/
fixtures/

# Web frontend (separate deployment)
web/

# SDK Python (separate package)
sdk/python/

# Pytest/Python test artifacts
.pytest_cache/
.mypy_cache/
