{
  "name": "@parle/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:groq": "vitest run --config vitest.config.ts __tests__/groq-integration.test.ts",
    "test:openai": "vitest run --config vitest.config.ts __tests__/openai-integration.test.ts",
    "test:fireworks": "vitest run --config vitest.config.ts __tests__/fireworks-integration.test.ts",
    "test:openrouter": "vitest run --config vitest.config.ts __tests__/openrouter-integration.test.ts",
    "test:modal": "vitest run --config vitest.config.ts __tests__/modal-tts-integration.test.ts",
    "test:fallback": "vitest run --config vitest.config.ts __tests__/fallback-integration.test.ts",
    "test:cross": "vitest run --config vitest.config.ts __tests__/cross-provider-integration.test.ts",
    "test:auth": "vitest run --config vitest.config.ts __tests__/auth-integration.test.ts",
    "test:adapters": "vitest run --config vitest.config.ts __tests__/adapters-integration.test.ts",
    "test:runpod": "vitest run --config vitest.config.ts __tests__/runpod-real-api.test.ts",
    "test:vast": "vitest run --config vitest.config.ts __tests__/vast-real-api.test.ts",
    "test:runpod-lifecycle": "vitest run --config vitest.config.ts __tests__/runpod-lifecycle.test.ts",
    "test:vast-lifecycle": "vitest run --config vitest.config.ts __tests__/vast-lifecycle.test.ts",
    "test:load": "vitest run --config vitest.config.ts __tests__/load-live.test.ts",
    "test:network": "vitest run --config vitest.config.ts __tests__/network-stress.test.ts",
    "test:soak": "vitest run --config vitest.config.ts __tests__/soak-live.test.ts",
    "test:k6:smoke": "k6 run load-testing/k6/smoke.js",
    "test:k6:100": "k6 run load-testing/k6/ramp-100.js",
    "test:k6:spike": "k6 run load-testing/k6/spike.js",
    "test:k6:soak": "k6 run load-testing/k6/soak.js",
    "test:stt-load": "vitest run --config vitest.config.ts __tests__/stt-load.test.ts",
    "test:coalescer": "vitest run --config vitest.config.ts __tests__/coalescer-effectiveness.test.ts",
    "test:cold-start": "vitest run --config vitest.config.ts __tests__/cold-start.test.ts",
    "test:zero-downtime": "vitest run --config vitest.config.ts __tests__/zero-downtime-deploy.test.ts",
    "test:breaking-point": "vitest run --config vitest.config.ts __tests__/breaking-point.test.ts",
    "test:memory-soak": "vitest run --config vitest.config.ts __tests__/memory-soak.test.ts",
    "test:cache": "vitest run --config vitest.config.ts __tests__/cache-effectiveness.test.ts",
    "test:snapgpu": "vitest run --config vitest.config.ts __tests__/snapgpu-sdk.test.ts",
    "test:snapgpu-benchmark": "vitest run --config vitest.config.ts __tests__/snapgpu-benchmark.test.ts",
    "test:object-storage": "bun --bun ./node_modules/.bin/vitest run --config vitest.config.ts __tests__/object-storage-r2-integration.test.ts"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "zod": ">=3.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^7.6.0",
    "franc": "6",
    "generate-function": "^2.3.1",
    "opusscript": "^0.1.1",
    "werift": "^0.22.9",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}
