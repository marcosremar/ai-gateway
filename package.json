{
  "name": "@parle/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ai-gateway": "./bin/ai-gateway.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./sdk/node/index.ts",
    "./compute": "./src/compute/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "postinstall": "bash scripts/postinstall.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "bun scripts/dev.ts",
    "sync": "bash scripts/sync-pod.sh",
    "sync:watch": "bash scripts/sync-pod.sh --watch",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'server/**/*.ts' --quiet",
    "lint:warnings": "eslint 'src/**/*.ts' 'server/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'server/**/*.ts' --fix",
    "quality:fitness": "bun run scripts/quality-fitness.ts",
    "quality:fitness:debt": "bun run scripts/quality-fitness.ts --warnings",
    "quality:fitness:strict": "bun run scripts/quality-fitness.ts --strict",
    "quality:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long src server sdk web/src",
    "quality:architecture:strict": "depcruise --config .dependency-cruiser.strict.cjs --output-type err-long src server sdk web/src",
    "quality:deadcode": "knip --config knip.json --no-config-hints --no-exit-code",
    "quality:deadcode:strict": "knip --config knip.json --no-config-hints",
    "quality:supply-chain": "bun run scripts/supply-chain-policy.ts",
    "quality:supply-chain:strict": "bun run scripts/supply-chain-policy.ts --strict",
    "quality:readme": "bun run scripts/update-quality-readme.ts",
    "quality:ai": "bun run typecheck && bun run lint && bun run build && bun run quality:fitness && bun run quality:supply-chain && bun run quality:architecture",
    "quality:ai:test": "bun run quality:ai && bun run test:unit",
    "quality:ai:deep": "bun run quality:ai:test && bun run quality:mutation",
    "quality:mutation": "bunx --bun @stryker-mutator/core run stryker.config.cjs",
    "insights:digest": "bun run scripts/telemetry-digest.ts",
    "test:cli": "vitest run __tests__/cli.test.ts",
    "test:e2e:browser": "cd tests-playwright && bunx playwright test",
    "test:e2e:browser:ui": "cd tests-playwright && bunx playwright test --ui",
    "test:e2e:fixtures": "bash tests-playwright/fixtures/generate-samples.sh",
    "test:e2e:corpus": "bash tests-playwright/fixtures/download-corpus.sh",
    "test:properties": "vitest run --config vitest.unit.config.ts __tests__/properties/",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:groq": "vitest run --config vitest.config.ts __tests__/groq-integration.test.ts",
    "test:openai": "vitest run --config vitest.config.ts __tests__/openai-integration.test.ts",
    "test:fireworks": "vitest run --config vitest.config.ts __tests__/fireworks-integration.test.ts",
    "test:openrouter": "vitest run --config vitest.config.ts __tests__/openrouter-integration.test.ts",
    "test:modal": "vitest run --config vitest.config.ts __tests__/modal-tts-integration.test.ts",
    "test:fallback": "vitest run --config vitest.config.ts __tests__/fallback-integration.test.ts",
    "test:cross": "vitest run --config vitest.config.ts __tests__/cross-provider-integration.test.ts",
    "test:auth": "vitest run --config vitest.config.ts __tests__/auth-integration.test.ts",
    "test:adapters": "vitest run --config vitest.config.ts __tests__/adapters-integration.test.ts",
    "test:runpod": "vitest run --config vitest.config.ts __tests__/runpod-real-api.test.ts",
    "test:vast": "vitest run --config vitest.config.ts __tests__/vast-real-api.test.ts",
    "test:runpod-lifecycle": "vitest run --config vitest.config.ts __tests__/runpod-lifecycle.test.ts",
    "test:vast-lifecycle": "vitest run --config vitest.config.ts __tests__/vast-lifecycle.test.ts",
    "test:load": "vitest run --config vitest.config.ts __tests__/load-live.test.ts",
    "test:network": "vitest run --config vitest.config.ts __tests__/network-stress.test.ts",
    "test:soak": "vitest run --config vitest.config.ts __tests__/soak-live.test.ts",
    "test:k6:smoke": "k6 run load-testing/k6/smoke.js",
    "test:k6:100": "k6 run load-testing/k6/ramp-100.js",
    "test:k6:spike": "k6 run load-testing/k6/spike.js",
    "test:k6:soak": "k6 run load-testing/k6/soak.js",
    "test:stt-load": "vitest run --config vitest.config.ts __tests__/stt-load.test.ts",
    "test:coalescer": "vitest run --config vitest.config.ts __tests__/coalescer-effectiveness.test.ts",
    "test:cold-start": "vitest run --config vitest.config.ts __tests__/cold-start.test.ts",
    "test:zero-downtime": "vitest run --config vitest.config.ts __tests__/zero-downtime-deploy.test.ts",
    "test:breaking-point": "vitest run --config vitest.config.ts __tests__/breaking-point.test.ts",
    "test:memory-soak": "vitest run --config vitest.config.ts __tests__/memory-soak.test.ts",
    "test:cache": "vitest run --config vitest.config.ts __tests__/cache-effectiveness.test.ts",
    "test:snapgpu": "vitest run --config vitest.config.ts __tests__/snapgpu-sdk.test.ts",
    "test:snapgpu-benchmark": "vitest run --config vitest.config.ts __tests__/snapgpu-benchmark.test.ts",
    "test:object-storage": "bun --bun ./node_modules/.bin/vitest run --config vitest.config.ts __tests__/object-storage-r2-integration.test.ts",
    "backup:db": "bash scripts/backup-database.sh"
  },
  "peerDependencies": {
    "openai": "^4.0.0",
    "zod": ">=3.20.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1027.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/spy": "^4.1.4",
    "dependency-cruiser": "^17.4.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "eslint-plugin-security": "^4.0.0",
    "fast-check": "^4.7.0",
    "knip": "^6.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^7.6.0",
    "context-mode": "^1.0.75",
    "franc": "6",
    "pino": "^10.3.1",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@pipecat-ai/client-js": "~1.7.0",
    "@pipecat-ai/small-webrtc-transport": "^1.10.0",
    "@prisma/adapter-neon": "7.6.0",
    "@prisma/adapter-pg": "7.6.0",
    "opusscript": "^0.1.1",
    "pg": "^8.13.0",
    "werift": "^0.22.9"
  },
  "overrides": {
    "hono": "^4.12.25",
    "ip-address": "^10.3.1",
    "lodash": "^4.18.0",
    "fast-uri": "^3.1.7"
  }
}
