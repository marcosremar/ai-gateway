# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,json}]
indent_size = 2

[*.{md,yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[*.py]
indent_size = 4

[{*.lock,bun.lockb}]
indent_style = space
indent_size = 2
