# Multi-stage production Dockerfile — optimized for size and security
# Usage: docker build -t ai-gateway:latest .

# ── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM oven/bun:1-alpine AS deps
WORKDIR /app

# Install only production dependencies
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production && \
    rm -rf /tmp/bun* /root/.bun/install/cache

# ── Stage 2: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1-alpine AS builder
WORKDIR /app

# Install all dependencies (including dev)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy source code
COPY src/ src/
COPY server/ server/
COPY sdk/ sdk/
COPY serve.ts tsconfig.json tsup.config.ts ./

# Build the library bundle AND compile serve.ts
RUN bun run build
RUN bun build --compile --minify --target=bun --outfile serve-compiled serve.ts

# ── Stage 3: Production ─────────────────────────────────────────────────────
FROM oven/bun:1-alpine AS production
WORKDIR /app

# Install wget for healthcheck (curl not available in alpine)
RUN apk add --no-cache wget ca-certificates && \
    rm -rf /var/cache/apk/*

# Copy production dependencies from stage 1
COPY --from=deps /app/node_modules ./node_modules

# Copy compiled binary and dist from builder
COPY --from=builder /app/serve-compiled ./serve-compiled
COPY --from=builder /app/dist ./dist

# Non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup
USER appuser

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:${PORT:-4000}/health || exit 1

EXPOSE ${PORT:-4000}

ENV NODE_ENV=production

CMD ["./serve-compiled"]
