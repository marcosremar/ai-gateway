# Multi-stage production Dockerfile — optimized for size and security
# Usage: docker build -t ai-gateway:latest .

# ── Stage 1: Dependencies ───────────────────────────────────────────────────
# Bun pinned (not the floating `1`): before 1.4.2 node:http never fired `close` on a client disconnect, so the
# per-user slot leaked and the upstream call was never aborted (fault bench 2026-10-06, item 14). Bump on purpose.
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS deps
WORKDIR /app

# Install only production dependencies
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts && \
    rm -rf /tmp/bun* /root/.bun/install/cache

# ── Stage 2: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS builder
WORKDIR /app

# Install all dependencies (including dev)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source code
COPY src/ src/
COPY server/ server/
COPY sdk/ sdk/
COPY serve.ts tsconfig.json tsup.config.ts ./
COPY scripts/reap-orphans.ts scripts/

# Build the library bundle AND compile serve.ts
RUN bun run build
RUN bun build --compile --minify --target=bun --outfile serve-compiled serve.ts
# Orphan guard, run by a separate Railway cron service from this same image (docs/deployments.md § Orphan guard)
RUN bun build --compile --minify --target=bun --outfile reap-compiled scripts/reap-orphans.ts

# ── Stage 3: Production ─────────────────────────────────────────────────────
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS production
WORKDIR /app

# Install wget for healthcheck (curl not available in alpine)
# apk upgrade: libssl3/libcrypto3 fixes newer than the base image (Trivy HIGH, 2026-10-04)
RUN apk add --no-cache wget ca-certificates && \
    apk upgrade --no-cache libssl3 libcrypto3 && \
    rm -rf /var/cache/apk/*

# Copy production dependencies from stage 1
COPY --from=deps /app/node_modules ./node_modules

# Copy compiled binary and dist from builder
COPY --from=builder /app/serve-compiled ./serve-compiled
COPY --from=builder /app/reap-compiled ./reap-compiled
COPY --from=builder /app/dist ./dist

# Non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup
USER appuser

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:${PORT:-4000}/health || exit 1

EXPOSE ${PORT:-4000}

ENV NODE_ENV=production

CMD ["./serve-compiled"]
