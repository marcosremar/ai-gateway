# Multi-stage production Dockerfile — optimized for size and security
# Usage: docker build -t ai-gateway:latest .

# ── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM oven/bun:1-alpine AS deps
WORKDIR /app

# Install only production dependencies
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts && \
    rm -rf /tmp/bun* /root/.bun/install/cache

# ── Stage 2: Build ──────────────────────────────────────────────────────────
FROM oven/bun:1-alpine AS builder
WORKDIR /app

# Install all dependencies (including dev)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source code
COPY src/ src/
COPY server/ server/
COPY bin/ bin/
COPY sdk/ sdk/
COPY serve.ts tsconfig.json tsup.config.ts ./

# Build the library bundle AND compile serve.ts
RUN bun run build
RUN bun build --compile --minify --target=bun --outfile serve-compiled serve.ts

# ── Stage 3: Production ─────────────────────────────────────────────────────
FROM oven/bun:1-alpine AS production
WORKDIR /app

# Install wget for healthcheck and SSH tools for GPU batch jobs.
RUN apk add --no-cache wget ca-certificates openssh-client rsync && \
    rm -rf /var/cache/apk/*

# Copy production dependencies from stage 1
COPY --from=deps /app/node_modules ./node_modules

# Copy compiled binary and dist from builder
COPY --from=builder /app/serve-compiled ./serve-compiled
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src ./src
COPY --from=builder /app/server ./server
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/sdk ./sdk
COPY --from=builder /app/serve.ts ./serve.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# Non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    mkdir -p /app/profiles /home/appuser/.babelcast /home/appuser/.ssh && \
    chmod 700 /home/appuser/.ssh && \
    chown -R appuser:appgroup /app/profiles /home/appuser/.babelcast /home/appuser/.ssh
USER appuser

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:${PORT:-4000}/health || exit 1

EXPOSE ${PORT:-4000}

ENV NODE_ENV=production
ENV HOME=/home/appuser
ENV AIGW_SSH_KEY=/home/appuser/.ssh/id_rsa

CMD ["sh", "-lc", "if [ -n \"${AIGW_SSH_PRIVATE_KEY:-}\" ]; then mkdir -p \"$HOME/.ssh\" && printf '%s\\n' \"$AIGW_SSH_PRIVATE_KEY\" > \"$AIGW_SSH_KEY\" && chmod 600 \"$AIGW_SSH_KEY\"; fi && exec bun run serve.ts"]
