# Test Environment Configuration
# This file is used for running tests locally and in CI.
# All values are safe for testing (no real API keys).

# AI Providers (use test/mock keys)
OPENAI_API_KEY=sk-test-mock-key-for-testing
GROQ_API_KEY=gsk_test-mock-key
OPENROUTER_API_KEY=sk-or-test-mock-key
FIREWORKS_API_KEY=fw_test-mock-key

# GPU Providers (mock/empty for unit tests)
RUNPOD_API_KEY=test-mock-key
TENSORDOCK_API_TOKEN=test-mock-key
TENSORDOCK_AUTH_ID=test-mock-id
VAST_API_KEY=test-mock-key
MODAL_TOKEN_ID=test-mock-id
MODAL_TOKEN_SECRET=test-mock-secret

# Infrastructure
HF_TOKEN=test-mock-token
GPU_ACCESS_SECRET=test-min-32-char-secret-for-testing-only

# Test-specific settings
NODE_ENV=test
SKIP_GPU_TESTS=1
SKIP_LIVE_TESTS=1
LOG_LEVEL=error

# Database (test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai-gateway-test

# Redis (test redis)
REDIS_URL=redis://localhost:6379/15

# Ollama (local testing)
OLLAMA_BASE_URL=http://localhost:11434
