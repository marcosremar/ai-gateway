FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04@sha256:92906d87596d638d35015c6353053121bd299d25943b875763321653884ba924

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install SnapGPU worker dependencies
COPY pyproject.toml .
RUN pip3 install --no-cache-dir --break-system-packages ".[worker]"

# Copy worker code
COPY snapgpu/ snapgpu/
COPY worker/ worker/

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["python3", "-m", "worker.runner"]
