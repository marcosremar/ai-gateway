{
  "name": "pocket-tts-finetune",
  "version": "1.0.0",
  "description": "Flow-matching finetune of kyutai/pocket-tts (Portuguese voice transfer). LSD loss, Mimi codec frozen.",
  "type": "audio",
  "trainerScript": "trainer.py",
  "prepareScript": "prepare_dataset.py",
  "tokenizerExtScript": "extend_tokenizer.py",
  "defaultModel": "hf://kyutai/pocket-tts",
  "defaultEpochs": 1,
  "defaultLR": 1e-6,
  "defaultGpu": "4090",
  "defaultMaxSpend": 1.50,
  "trainerInterface": {
    "encode": "python trainer.py encode --input <jsonl> --output <pt> [--num-workers 8] [--max-samples N]",
    "train":  "python trainer.py train --tokens <pt> --output <dir> --epochs N --learning-rate X [--resume <dir>]"
  },
  "aptDeps": "pkg-config build-essential libsentencepiece-dev libsndfile1 ffmpeg",
  "pipDeps": "huggingface-hub hf_xet hf_transfer torch torchaudio safetensors soundfile pocket-tts",
  "torchCudaIndex": "https://download.pytorch.org/whl/cu121",
  "torchVersion": "2.1.2",
  "knownTags": ["[laugh]", "[sigh]", "[gasp]", "[cough]", "[sniff]", "[throat]", "[sneeze]"],
  "notes": "Mimi codec MUST be frozen. LR sweet spot ~1e-6. 1-3 epochs (overfit risk past that). Use intermediate ckpt not final."
}
