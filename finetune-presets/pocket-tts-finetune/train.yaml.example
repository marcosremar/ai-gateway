# Example train.yaml — drop this in dataset repo + nothing else needed.
# Usage:
#   ai-gateway gpu finetune submit -f train.yaml
#
# ai-gateway loads bundled pocket-tts-finetune trainer (no user script needed).
# 2-repo output: <hfBase> (weights) + <hfBase>-dataset (encoded.pt + this yaml).

type: pocket-tts-finetune          # built-in preset, no script: needed
aigwVersion: 1.0.0                 # pin trainer version for reproducibility

# prepare: auto                    # default: ai-gateway runs preset's prepare_dataset.py
                                   #          on /root/data/metadata.jsonl (or train.jsonl)
# prepare: skip                    # already pre-encoded; ai-gateway runs encode directly
# prepare: <custom-shell-command>  # full override

# Data + model
dataset: hf://marcosremar2/gemini-dataset-erinome
dataset-include: wav/*,metadata.jsonl  # need wav + manifest; skip text/ to save bandwidth
noHfTransfer: true                 # avoid 429 on small-file datasets
model: hf://kyutai/pocket-tts      # OR hf://marcosremar2/pocket-tts-ptbr-tagextended

# Training hyperparams
epochs: 1                          # research: TTS finetune overfits at 1-3 epochs
lr: 1e-6                           # research: pocket-tts sweet spot
maxSamples: 1500                   # cap encode size (omit for full dataset)
saveEverySteps: 25                 # frequent ckpts → pick best intermediate

# Output
hfBase: marcosremar2/iaratts-100M-ptbr-erinome-v2
                                   # creates: <hfBase> (weights) + <hfBase>-dataset

# Runtime
gpu: 4090
maxCost: 0.4                       # $/h cap
maxSpend: 1.0                      # hard $ total cap
preferSpot: true
gpuFallback: true                  # walk 4090→3090→A5000 ladder if primary unavailable
autoLrRewind: true                 # restore last good ckpt if loss diverges

# Quality automation — ai-gateway picks smart defaults
quality: auto                      # auto = torch.compile + plateau-stop (epochs≥2)
                                   # safe = no auto-stop, no compile (debug runs)
                                   # fast = + pitch/speed augment (small dataset boost)

# Docker image (optional — default = marcosremar/gpu-dev:latest)
# Use generic finetune base for ~3-4 min faster boot:
#   image: ghcr.io/<user>/aigw-finetune-base:latest
# Build it once: see /Users/marcos/projects/ai-gateway/dockers/aigw-finetune-base/Dockerfile

# ─────────────────────────────────────────────────────────────────
# Tier 2 — advanced overrides (quality:auto handles 80% — leave commented unless you know why)
# ─────────────────────────────────────────────────────────────────
# batchSize: 2                 # micro-batch (4090=2 for 100M model; smaller GPU → 1)
# gradAccum: 16                # effective batch = batchSize × gradAccum
# weightDecay: 0.01            # AdamW weight decay
# warmupSteps: 200             # LR warmup before cosine decay
# freezeBackboneLayers: 4      # freeze first N transformer blocks (0 = train all = unstable)
# onlyFlowNet: false           # LoRA-style: train ONLY flow_net + out_eos (minimal surface)
# curriculum: ""               # "" = random | "linear" = sort by length (short→long)
# saveEverySteps: 100          # checkpoint cadence (smaller = more rewind options + slower)
# evalsPerEpoch: 0             # run validation N times per epoch (0 = disabled)
# multiDataset:                # weighted multi-dataset combine
#   - { path: "ds1.pt", weight: 3.0 }
#   - { path: "ds2.pt", weight: 1.0 }
